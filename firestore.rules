// Firestore Security Rules
//
// 設計の根拠・各判断の理由は docs/firestore-design.md §8 を参照。
// 基本方針: 明示的に許可したものだけ通す。デフォルト拒否。
// 各 match ブロックはヘルパー関数（isAdmin 等）の呼び出しだけにし、
// 将来の権限モデル変更（§6）はヘルパーの中身の差し替えだけで対応できるようにする。

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ログイン済みか
    function signedIn() {
      return request.auth != null;
    }

    // 自分の users/{uid} ドキュメント
    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // 指定施設に所属しているか
    function inFacility(fid) {
      return signedIn() && (fid in me().facilityIds);
    }

    // 指定施設の管理者か
    function isAdmin(fid) {
      return inFacility(fid) && me().role == 'admin';
    }

    // 自分に紐づく staff ドキュメントID（管理者専任なら null）
    function myStaffId() {
      return me().linkedStaffId;
    }

    // leaveRequests の不変フィールドが変更されていないか
    function leaveImmutableKept() {
      return request.resource.data.staffId      == resource.data.staffId
          && request.resource.data.createdByUid == resource.data.createdByUid
          && request.resource.data.yearMonth    == resource.data.yearMonth
          && request.resource.data.date         == resource.data.date;
    }

    match /organizations/{orgId} {
      allow read:  if signedIn() && me().organizationId == orgId;
      allow write: if false; // 当面コンソール管理
    }

    match /facilities/{fid} {
      // 所属施設は誰でも読める。未所属でも、同一組織の管理者なら横展開の管理画面用に読める
      allow read:   if inFacility(fid)
                    || (signedIn() && me().role == 'admin' && me().organizationId == resource.data.organizationId);
      // 更新: その施設の管理者、または（施設・ユーザー管理画面用に）同一組織の管理者なら未所属でも可
      allow update: if isAdmin(fid)
                    || (signedIn() && me().role == 'admin'
                        && me().organizationId == resource.data.organizationId
                        && request.resource.data.organizationId == resource.data.organizationId);
      // 新規施設の作成は、自分の組織宛てになら管理者が行える（施設・ユーザー管理画面）
      allow create: if signedIn() && me().role == 'admin'
                    && request.resource.data.organizationId == me().organizationId;
      allow delete: if false;

      match /jobTypes/{id}        { allow read: if inFacility(fid); allow write: if isAdmin(fid); }
      match /employmentTypes/{id} { allow read: if inFacility(fid); allow write: if isAdmin(fid); }
      match /shiftPatterns/{id}   { allow read: if inFacility(fid); allow write: if isAdmin(fid); }
      match /rules/{id}           { allow read: if inFacility(fid); allow write: if isAdmin(fid); }
      match /compatibilities/{id} { allow read: if inFacility(fid); allow write: if isAdmin(fid); }
      match /settings/{id}        { allow read: if inFacility(fid); allow write: if isAdmin(fid); }
      match /staff/{staffId}      { allow read: if inFacility(fid); allow write: if isAdmin(fid); }

      match /schedules/{ym} {
        allow read:  if inFacility(fid);
        allow write: if isAdmin(fid);

        match /candidates/{cid} {
          allow read:  if inFacility(fid);
          allow write: if isAdmin(fid);
        }
      }

      match /leaveRequests/{reqId} {
        // 読み取り: admin は全件 / 本人は自分の分のみ
        allow read: if isAdmin(fid)
                    || (inFacility(fid) && resource.data.staffId == myStaffId());

        // 作成: admin は誰の分でも作成可（現状は職員個人ログインが無く、
        //       管理者が全職員分をまとめて入力する運用のため）。
        //       admin以外（本人）は自分の分のみ、作成者と本人を強制、初期 status は pending 固定
        allow create: if isAdmin(fid)
                    || (inFacility(fid)
                        && request.resource.data.staffId      == myStaffId()
                        && request.resource.data.createdByUid == request.auth.uid
                        && request.resource.data.status       == 'pending');

        // 更新: admin は無制限（承認・却下を含む）。不変フィールドは admin でも変更不可
        allow update: if isAdmin(fid) && leaveImmutableKept();

        // 更新: 本人は pending の間だけ、status を pending のまま保ったときのみ編集可
        //       （承認・却下は不可。staffId/createdByUid/yearMonth/date も変更不可）
        allow update: if inFacility(fid)
                    && resource.data.staffId        == myStaffId()
                    && resource.data.status         == 'pending'
                    && request.resource.data.status == 'pending'
                    && leaveImmutableKept();

        // 削除: admin、または本人が pending のうちに取消
        allow delete: if isAdmin(fid)
                    || (inFacility(fid) && resource.data.staffId == myStaffId()
                        && resource.data.status == 'pending');
      }
    }

    match /users/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid
                   || (me().role == 'admin' && me().organizationId == resource.data.organizationId));

      // 管理者アカウントの招待（施設・ユーザー管理画面）。v1は招待できる役割を admin に限定
      allow create: if signedIn() && me().role == 'admin'
                    && request.resource.data.organizationId == me().organizationId
                    && request.resource.data.role == 'admin';

      // 所属施設・主施設の付け替え。組織を跨いだ付け替えは不可
      allow update: if signedIn() && me().role == 'admin'
                    && me().organizationId == resource.data.organizationId
                    && request.resource.data.organizationId == resource.data.organizationId;

      allow delete: if false; // 当面コンソール管理
    }
  }
}
