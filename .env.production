# prod 環境（Firebase プロジェクト: kaigo-shift-saas-prod）の接続情報。
# kaigo-shift-saas-prod プロジェクト作成後、Firebase コンソールの
# 「プロジェクトの設定」→「マイアプリ」→ ウェブアプリの firebaseConfig の値を記入する。
# Firebase Web の接続情報は秘密情報ではないため、このファイルはコミットしてよい。
# 詳細は docs/environment-strategy.md を参照。

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
