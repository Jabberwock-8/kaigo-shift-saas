# Firebase ウェブアプリの接続情報のひな形。
#
# 通常は使わなくてよい: dev/prod の値はそれぞれ .env.development / .env.production に
# コミット済み（詳細は docs/environment-strategy.md）。
#
# このファイルは、個人の手元だけで一時的に別の値を使いたいとき用。
# コピーして .env.local を作ると、.env.development / .env.production より優先される
# （.env.local は .gitignore 済み）。

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
